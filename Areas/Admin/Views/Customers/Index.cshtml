@using DjStoreWeb.Models
@model List<AppUser>
@{
    ViewData["Title"] = "Khách hàng";
}

<form class="d-flex gap-2 mb-3" method="get">
    <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="Tìm theo tên hoặc email..." />
    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
</form>

<div class="card stat-card p-3">
    <table class="table align-middle">
        <thead><tr><th>Khách hàng</th><th>Điện thoại</th><th>Địa chỉ</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td class="d-flex align-items-center gap-2">
                        <img src="@u.Avatar" style="width:36px;height:36px;object-fit:cover;border-radius:50%" />
                        <div>
                            <div>@u.Name</div>
                            <div class="text-muted small">@u.Email</div>
                        </div>
                    </td>
                    <td>@u.Phone</td>
                    <td class="text-muted small">@u.Address</td>
                    <td>
                        @if (u.IsActive)
                        {
                            <span class="badge bg-success">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Đã khóa</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                        <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-warning">@(u.IsActive ? "Khóa" : "Mở khóa")</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">Không có khách hàng nào.</td></tr>
            }
        </tbody>
    </table>
</div>
