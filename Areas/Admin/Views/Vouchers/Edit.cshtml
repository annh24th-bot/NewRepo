@using DjStoreWeb.Models
@model Voucher
@{
    ViewData["Title"] = "Sửa mã giảm giá";
}

<form asp-action="Edit" asp-route-id="@Model.Code" method="post" class="card stat-card p-4" style="max-width:640px;">
    <div class="mb-3">
        <label class="form-label">Mã voucher</label>
        <input value="@Model.Code" class="form-control" disabled />
    </div>
    <div class="mb-3">
        <label class="form-label">Mô tả</label>
        <input name="Description" value="@Model.Description" class="form-control" />
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Loại giảm giá</label>
            <select name="DiscountType" class="form-select">
                <option value="percent" selected="@(Model.DiscountType == "percent")">Theo phần trăm (%)</option>
                <option value="fixed" selected="@(Model.DiscountType == "fixed")">Số tiền cố định (đ)</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Giá trị</label>
            <input name="DiscountValue" type="number" value="@Model.DiscountValue" class="form-control" required />
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Đơn hàng tối thiểu (đ)</label>
            <input name="MinOrder" type="number" value="@Model.MinOrder" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Ngày hết hạn</label>
            <input name="ExpiryDate" type="date" value="@Model.ExpiryDate?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Giới hạn lượt dùng (0 = không giới hạn)</label>
        <input name="UsageLimit" type="number" value="@Model.UsageLimit" class="form-control" />
    </div>
    <div class="form-check mb-3">
        <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="isActive" checked="@(Model.IsActive)" />
        <label class="form-check-label" for="isActive">Đang kích hoạt</label>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>
