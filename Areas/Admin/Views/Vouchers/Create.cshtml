@using DjStoreWeb.Models
@model Voucher
@{
    ViewData["Title"] = "Tạo mã giảm giá";
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@e.ErrorMessage</div>
        }
    </div>
}

<form asp-action="Create" method="post" class="card stat-card p-4" style="max-width:640px;">
    <div class="mb-3">
        <label class="form-label">Mã voucher</label>
        <input name="Code" value="@Model.Code" class="form-control text-uppercase" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Mô tả</label>
        <input name="Description" value="@Model.Description" class="form-control" />
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Loại giảm giá</label>
            <select name="DiscountType" class="form-select">
                <option value="percent">Theo phần trăm (%)</option>
                <option value="fixed">Số tiền cố định (đ)</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Giá trị</label>
            <input name="DiscountValue" type="number" class="form-control" required />
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Đơn hàng tối thiểu (đ)</label>
            <input name="MinOrder" type="number" value="0" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Ngày hết hạn</label>
            <input name="ExpiryDate" type="date" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Giới hạn lượt dùng (0 = không giới hạn)</label>
        <input name="UsageLimit" type="number" value="0" class="form-control" />
    </div>
    <div class="form-check mb-3">
        <input type="checkbox" name="IsActive" value="true" checked class="form-check-input" id="isActive" />
        <label class="form-check-label" for="isActive">Kích hoạt ngay</label>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Tạo mã</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>
