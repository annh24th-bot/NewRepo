@using DjStoreWeb.Areas.Admin.Controllers
@model DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="text-muted small">Doanh thu</div>
            <div class="fs-4 fw-bold text-success">@Model.TotalRevenue.ToString("N0")đ</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="text-muted small">Tổng đơn hàng</div>
            <div class="fs-4 fw-bold">@Model.TotalOrders</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="text-muted small">Sản phẩm</div>
            <div class="fs-4 fw-bold">@Model.TotalProducts</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="text-muted small">Khách hàng</div>
            <div class="fs-4 fw-bold">@Model.TotalCustomers</div>
        </div>
    </div>
</div>

@if (Model.UnhandledMessages > 0 || Model.UnrepliedReviews > 0)
{
    <div class="row g-3 mb-4">
        @if (Model.UnhandledMessages > 0)
        {
            <div class="col-md-6">
                <a asp-area="Admin" asp-controller="Messages" asp-action="Index" asp-route-filter="unhandled" class="text-decoration-none">
                    <div class="card stat-card p-3 border-start border-4 border-warning">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small"><i class="bi bi-envelope me-1"></i>Liên hệ chưa phản hồi</div>
                                <div class="fs-4 fw-bold text-dark">@Model.UnhandledMessages</div>
                            </div>
                            <i class="bi bi-arrow-right-circle fs-3 text-warning"></i>
                        </div>
                    </div>
                </a>
            </div>
        }
        @if (Model.UnrepliedReviews > 0)
        {
            <div class="col-md-6">
                <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" asp-route-filter="unreplied" class="text-decoration-none">
                    <div class="card stat-card p-3 border-start border-4 border-info">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small"><i class="bi bi-star me-1"></i>Đánh giá chưa phản hồi</div>
                                <div class="fs-4 fw-bold text-dark">@Model.UnrepliedReviews</div>
                            </div>
                            <i class="bi bi-arrow-right-circle fs-3 text-info"></i>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

<div class="row g-3">
    <div class="col-md-8">
        <div class="card stat-card p-3 mb-3">
            <h6 class="mb-3">Doanh thu 7 ngày gần nhất</h6>
            <canvas id="revenueChart" height="90"></canvas>
        </div>

        <div class="card stat-card p-3">
            <h6 class="mb-3">Đơn hàng gần đây</h6>
            <table class="table table-sm align-middle">
                <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày</th><th>Trạng thái</th><th class="text-end">Tổng tiền</th></tr></thead>
                <tbody>
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td><a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">#@o.OrderCode</a></td>
                            <td>@o.CustomerName</td>
                            <td>@o.Date.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-secondary">@o.Status</span></td>
                            <td class="text-end">@o.Total.ToString("N0")đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card stat-card p-3">
            <h6 class="mb-3 text-danger">⚠ Sản phẩm sắp hết hàng</h6>
            <ul class="list-group list-group-flush">
                @foreach (var p in Model.LowStockProducts)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@p.Name</span>
                        <span class="badge bg-danger">@p.Stock</span>
                    </li>
                }
                @if (!Model.LowStockProducts.Any())
                {
                    <li class="list-group-item text-muted">Không có sản phẩm nào sắp hết hàng.</li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const ctx = document.getElementById('revenueChart');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueLabels)),
                datasets: [{
                    label: 'Doanh thu (đ)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueValues)),
                    borderColor: '#f97316',
                    backgroundColor: 'rgba(249,115,22,.15)',
                    tension: .3,
                    fill: true
                }]
            },
            options: { plugins: { legend: { display: false } } }
        });
    </script>
}
