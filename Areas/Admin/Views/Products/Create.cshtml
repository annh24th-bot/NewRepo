@using DjStoreWeb.Models
@model Product
@{
    ViewData["Title"] = "Thêm sản phẩm";
    var categories = (List<Category>)ViewBag.Categories;
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@e.ErrorMessage</div>
        }
    </div>
}

<form asp-action="Create" method="post" class="card stat-card p-4">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Mã sản phẩm</label>
            <input name="Id" value="@Model.Id" class="form-control" required />
        </div>
        <div class="col-md-6">
            <label class="form-label">Tên sản phẩm</label>
            <input name="Name" class="form-control" required />
        </div>
        <div class="col-md-4">
            <label class="form-label">Danh mục</label>
            <select name="CategoryId" id="categorySelect" class="form-select" required onchange="toggleDriveLinkField()">
                @foreach (var c in categories)
                {
                    <option value="@c.Id" data-digital="@(new[] { "music-pack", "software-license", "google-drive" }.Contains(c.Id) ? "true" : "false")">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Thương hiệu</label>
            <input name="Brand" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Ảnh (URL)</label>
            <input name="Image" class="form-control" placeholder="https://..." />
        </div>
        <div class="col-md-4">
            <label class="form-label">Giá bán</label>
            <input name="Price" type="number" step="1000" class="form-control" required />
        </div>
        <div class="col-md-4">
            <label class="form-label">Giá gốc (nếu có)</label>
            <input name="OriginalPrice" type="number" step="1000" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Nhãn giảm giá</label>
            <input name="Discount" class="form-control" placeholder="Ví dụ: 10%" />
        </div>
        <div class="col-md-12" id="driveLinkField" style="display:none;">
            <label class="form-label">
                <i class="bi bi-google me-1"></i>Link Google Drive <span class="text-muted small">(nhạc / phần mềm / tệp lưu trữ — sẽ gửi cho khách sau khi đơn hàng được xử lý)</span>
            </label>
            <input name="DriveLink" type="url" class="form-control" placeholder="https://drive.google.com/drive/folders/..." />
        </div>
        <div class="col-md-12">
            <label class="form-label">Mô tả</label>
            <textarea name="Description" rows="3" class="form-control"></textarea>
        </div>
        <div class="col-md-6 form-check ms-1">
            <input type="checkbox" name="FlashSale" value="true" class="form-check-input" id="flashSale" />
            <label class="form-check-label" for="flashSale">Flash Sale</label>
        </div>
        <div class="col-md-6 form-check ms-1">
            <input type="checkbox" name="IsActive" value="true" checked class="form-check-input" id="isActive" />
            <label class="form-check-label" for="isActive">Đang bán</label>
        </div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Lưu sản phẩm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

<script>
    function toggleDriveLinkField() {
        var select = document.getElementById('categorySelect');
        var field = document.getElementById('driveLinkField');
        var opt = select.options[select.selectedIndex];
        field.style.display = (opt && opt.dataset.digital === 'true') ? 'block' : 'none';
    }
    document.addEventListener('DOMContentLoaded', toggleDriveLinkField);
</script>
