@using DjStoreWeb.Models
@model List<Order>
@{
    ViewData["Title"] = "Đơn hàng";
    var statuses = (string[])ViewBag.Statuses;
}

<form class="d-flex gap-2 mb-3" method="get">
    <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="Tìm theo mã đơn, email, tên khách..." />
    <select name="status" class="form-select" onchange="this.form.submit()">
        <option value="">Tất cả trạng thái</option>
        @foreach (var s in statuses)
        {
            <option value="@s" selected="@(ViewBag.Status == s)">@s</option>
        }
    </select>
    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
</form>

<div class="card stat-card p-3">
    <table class="table align-middle">
        <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Thanh toán</th><th>Trạng thái</th><th class="text-end">Tổng tiền</th><th></th></tr></thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>#@o.OrderCode</td>
                    <td>@o.CustomerName <div class="text-muted small">@o.CustomerEmail</div></td>
                    <td>@o.Date.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@o.PaymentMethod</td>
                    <td><span class="badge bg-secondary">@o.Status</span></td>
                    <td class="text-end">@o.Total.ToString("N0")đ</td>
                    <td class="text-end"><a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Chi tiết</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Không có đơn hàng nào phù hợp.</td></tr>
            }
        </tbody>
    </table>
</div>
