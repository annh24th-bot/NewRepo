@using DjStoreWeb.Data
@inject AppDbContext DbCtx
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - DJ Store Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body { background: #f3f4f6; }
        .sidebar { min-height: 100vh; background: #111827; color: #d1d5db; width: 240px; }
        .sidebar a { color: #d1d5db; text-decoration: none; display: block; padding: .6rem 1rem; border-radius: .5rem; }
        .sidebar a:hover, .sidebar a.active { background: #f97316; color: white; }
        .sidebar .brand { color: white; font-weight: 900; font-size: 1.25rem; }
        .layout { display: flex; }
        .content { flex: 1; padding: 2rem; }
        .stat-card { border: none; border-radius: 1rem; box-shadow: 0 4px 16px rgba(0,0,0,.06); }
    </style>
</head>
<body>
    <div class="layout">
        <nav class="sidebar p-3">
            <div class="brand mb-4 px-1"><span style="color:#f97316">DJ</span>STORE <small class="d-block text-secondary" style="font-size:.65rem;">ADMIN PANEL</small></div>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Tổng quan</a>
            <a asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam me-2"></i>Sản phẩm</a>
            <a asp-area="Admin" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags me-2"></i>Danh mục</a>
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt me-2"></i>Đơn hàng</a>
            <a asp-area="Admin" asp-controller="Warehouse" asp-action="Index"><i class="bi bi-boxes me-2"></i>Kho hàng</a>
            <a asp-area="Admin" asp-controller="Vouchers" asp-action="Index"><i class="bi bi-ticket-perforated me-2"></i>Mã giảm giá</a>
            <a asp-area="Admin" asp-controller="Customers" asp-action="Index"><i class="bi bi-people me-2"></i>Khách hàng</a>
            @if (User.IsInRole("admin"))
            {
                <a asp-area="Admin" asp-controller="Staffs" asp-action="Index"><i class="bi bi-person-badge me-2"></i>Nhân viên</a>
            }
            <a asp-area="Admin" asp-controller="News" asp-action="Index"><i class="bi bi-newspaper me-2"></i>Tin tức</a>
            <hr class="border-secondary" />
            <a asp-area="Admin" asp-controller="Messages" asp-action="Index" class="d-flex justify-content-between align-items-center">
                <span><i class="bi bi-envelope me-2"></i>Liên hệ</span>
                @{
                    var unhandledMsg = DbCtx.ContactMessages.Count(m => !m.IsHandled);
                }
                @if (unhandledMsg > 0)
                {
                    <span class="badge bg-danger rounded-pill">@unhandledMsg</span>
                }
            </a>
            <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" class="d-flex justify-content-between align-items-center">
                <span><i class="bi bi-star me-2"></i>Đánh giá</span>
                @{
                    var unrepliedReviews = DbCtx.Reviews.Count(r => r.AdminReply == null);
                }
                @if (unrepliedReviews > 0)
                {
                    <span class="badge bg-danger rounded-pill">@unrepliedReviews</span>
                }
            </a>
            <hr class="border-secondary" />
            <a asp-controller="Home" asp-action="Index" asp-area=""><i class="bi bi-shop me-2"></i>Về trang cửa hàng</a>
            <a asp-controller="Account" asp-action="Logout" asp-area="" class="text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
        </nav>

        <main class="content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div class="text-muted small">Xin chào, <strong>@User.Identity?.Name</strong></div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
