@using DjStoreWeb.Models
@model Category
@{
    ViewData["Title"] = "Sửa danh mục";
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card stat-card p-4" style="max-width:640px;">
    <div class="mb-3">
        <label class="form-label">Mã danh mục</label>
        <input value="@Model.Id" class="form-control" disabled />
    </div>
    <div class="mb-3">
        <label class="form-label">Tên danh mục</label>
        <input name="Name" value="@Model.Name" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Icon (tên Lucide icon)</label>
        <input name="Icon" value="@Model.Icon" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Mô tả</label>
        <textarea name="Description" rows="3" class="form-control">@Model.Description</textarea>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>
