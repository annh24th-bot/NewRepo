@using DjStoreWeb.Models
@model Category
@{
    ViewData["Title"] = "Thêm danh mục";
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@e.ErrorMessage</div>
        }
    </div>
}

<form asp-action="Create" method="post" class="card stat-card p-4" style="max-width:640px;">
    <div class="mb-3">
        <label class="form-label">Mã danh mục (không dấu, không khoảng trắng)</label>
        <input name="Id" value="@Model.Id" class="form-control" required placeholder="vi-du: turntable" />
    </div>
    <div class="mb-3">
        <label class="form-label">Tên danh mục</label>
        <input name="Name" value="@Model.Name" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Icon (tên Lucide icon)</label>
        <input name="Icon" value="@Model.Icon" class="form-control" placeholder="Package" />
    </div>
    <div class="mb-3">
        <label class="form-label">Mô tả</label>
        <textarea name="Description" rows="3" class="form-control">@Model.Description</textarea>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Lưu danh mục</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>
