@using DjStoreWeb.Models
@model List<Category>
@{
    ViewData["Title"] = "Danh mục";
    var counts = (Dictionary<string, int>)ViewBag.ProductCounts;
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm danh mục</a>
</div>

<div class="card stat-card p-3">
    <table class="table align-middle">
        <thead><tr><th>Mã</th><th>Tên danh mục</th><th>Mô tả</th><th>Số sản phẩm</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><code>@c.Id</code></td>
                    <td>@c.Name</td>
                    <td class="text-muted small">@c.Description</td>
                    <td>@(counts.ContainsKey(c.Id) ? counts[c.Id] : 0)</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa danh mục này?')">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
