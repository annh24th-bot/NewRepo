@using DjStoreWeb.Models
@model List<NewsPost>
@{
    ViewData["Title"] = "Tin tức";
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Đăng bài viết</a>
</div>

<div class="card stat-card p-3">
    <table class="table align-middle">
        <thead><tr><th>Ảnh</th><th>Tiêu đề</th><th>Chuyên mục</th><th>Ngày đăng</th><th>Lượt xem</th><th></th></tr></thead>
        <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td><img src="@n.Image" style="width:56px;height:40px;object-fit:cover;border-radius:6px" /></td>
                    <td>@n.Title</td>
                    <td><span class="badge bg-secondary">@n.Category</span></td>
                    <td>@n.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>@n.Views</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@n.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@n.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa bài viết này?')">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Chưa có bài viết nào.</td></tr>
            }
        </tbody>
    </table>
</div>
