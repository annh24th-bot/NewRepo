@using DjStoreWeb.Models
@model NewsPost
@{
    ViewData["Title"] = Model.Title;
    var others = (List<NewsPost>)ViewBag.Others;
}
<div class="max-w-3xl mx-auto px-4 py-12">
    <span class="text-xs text-brand">@Model.Category</span>
    <h1 class="text-2xl md:text-3xl font-black mt-1 mb-3">@Model.Title</h1>
    <div class="text-sm text-neutral-500 mb-6">Tác giả: @Model.Author · @Model.CreatedAt.ToString("dd/MM/yyyy") · @Model.Views lượt xem</div>

    <img src="@Model.Image" class="w-full rounded-xl mb-6 object-cover" alt="@Model.Title" />

    <div class="prose prose-invert max-w-none text-neutral-300 leading-relaxed whitespace-pre-line">@Model.Content</div>

    @if (others.Any())
    {
        <div class="mt-12 border-t border-neutral-800 pt-6">
            <h2 class="font-bold mb-4">Bài viết khác</h2>
            <div class="grid md:grid-cols-2 gap-4">
                @foreach (var n in others)
                {
                    <a asp-controller="News" asp-action="Detail" asp-route-id="@n.Id" class="flex gap-3 bg-neutral-900 border border-neutral-800 rounded-xl p-3 hover:border-brand">
                        <img src="@n.Image" class="w-20 h-16 object-cover rounded-lg" alt="@n.Title" />
                        <div class="text-sm font-semibold line-clamp-2">@n.Title</div>
                    </a>
                }
            </div>
        </div>
    }
</div>
