@using DjStoreWeb.Models
@model List<CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
    var subtotal = Model.Sum(i => i.LineTotal);
}
<div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-2xl font-black mb-6">Giỏ hàng của bạn</h1>

    @if (!Model.Any())
    {
        <div class="text-center py-16">
            <p class="text-neutral-500 mb-6">Giỏ hàng của bạn đang trống.</p>
            <a asp-controller="Home" asp-action="Shop" class="bg-brand hover:bg-brand-dark text-white font-bold px-8 py-3 rounded-full">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="grid md:grid-cols-3 gap-8">
            <div class="md:col-span-2 space-y-4">
                @foreach (var item in Model)
                {
                    <div class="flex gap-4 bg-neutral-900 border border-neutral-800 rounded-xl p-4">
                        <img src="@item.Image" class="w-20 h-20 object-cover rounded-lg" alt="@item.Name" />
                        <div class="flex-1">
                            <div class="font-semibold text-sm">@item.Name</div>
                            <div class="text-brand font-bold mt-1">@item.Price.ToString("N0")đ</div>
                        </div>
                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="flex items-center gap-2">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="number" name="quantity" value="@item.Quantity" min="0"
                                   class="w-16 bg-neutral-800 border border-neutral-700 rounded-lg px-2 py-1 text-center text-sm" />
                            <button type="submit" class="text-xs bg-neutral-800 hover:bg-neutral-700 px-3 py-1.5 rounded-lg">Cập nhật</button>
                        </form>
                        <form asp-controller="Cart" asp-action="Remove" method="post">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="text-xs text-red-400 hover:text-red-300 px-2">Xóa</button>
                        </form>
                    </div>
                }
            </div>

            <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 h-fit">
                <h2 class="font-bold mb-4">Tóm tắt đơn hàng</h2>
                <div class="flex justify-between text-sm mb-2">
                    <span class="text-neutral-400">Tạm tính</span>
                    <span>@subtotal.ToString("N0")đ</span>
                </div>
                <div class="border-t border-neutral-800 my-3"></div>
                <div class="flex justify-between font-bold text-lg mb-6">
                    <span>Tổng cộng</span>
                    <span class="text-brand">@subtotal.ToString("N0")đ</span>
                </div>
                <a asp-controller="Cart" asp-action="Checkout" class="block text-center bg-brand hover:bg-brand-dark text-white font-bold py-3 rounded-full">Tiến hành thanh toán</a>
            </div>
        </div>
    }
</div>
