@{
    ViewData["Title"] = "Đăng ký";
}
<div class="max-w-md mx-auto px-4 py-16">
    <h1 class="text-2xl font-black mb-6 text-center">Tạo tài khoản mới</h1>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bg-red-900/40 border border-red-700 text-red-300 text-sm rounded-lg px-4 py-3 mb-4">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }

    <form asp-controller="Account" asp-action="Register" method="post" class="space-y-4 bg-neutral-900 border border-neutral-800 rounded-xl p-6">
        <div>
            <label class="block text-sm text-neutral-400 mb-1">Họ và tên</label>
            <input name="name" required class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm text-neutral-400 mb-1">Email</label>
            <input type="email" name="email" required class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm text-neutral-400 mb-1">Số điện thoại</label>
            <input name="phone" class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm text-neutral-400 mb-1">Địa chỉ</label>
            <input name="address" class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm text-neutral-400 mb-1">Mật khẩu</label>
            <input type="password" name="password" required class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm text-neutral-400 mb-1">Xác nhận mật khẩu</label>
            <input type="password" name="confirmPassword" required class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-2" />
        </div>
        <button type="submit" class="w-full bg-brand hover:bg-brand-dark text-white font-bold py-3 rounded-full">Đăng ký</button>
        <div class="text-sm text-neutral-400 text-center">
            Đã có tài khoản? <a asp-controller="Account" asp-action="Login" class="text-brand hover:underline">Đăng nhập</a>
        </div>
    </form>
</div>
