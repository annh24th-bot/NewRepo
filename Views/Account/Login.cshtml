@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="max-w-md mx-auto px-4 py-16">
    <h1 class="text-2xl font-black mb-6 text-center">Đăng nhập</h1>

    @if (TempData["RegisterSuccess"] != null)
    {
        <div class="bg-green-900/40 border border-green-700 text-green-300 text-sm rounded-lg px-4 py-3 mb-4">@TempData["RegisterSuccess"]</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bg-red-900/40 border border-red-700 text-red-300 text-sm rounded-lg px-4 py-3 mb-4">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }

    <form asp-controller="Account" asp-action="Login" method="post" class="space-y-4 bg-neutral-900 border border-neutral-800 rounded-xl p-6">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div>
            <label class="block text-sm text-neutral-400 mb-1">Email</label>
            <input type="email" name="email" required class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm text-neutral-400 mb-1">Mật khẩu</label>
            <input type="password" name="password" required class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-2" />
        </div>
        <button type="submit" class="w-full bg-brand hover:bg-brand-dark text-white font-bold py-3 rounded-full">Đăng nhập</button>
        <div class="flex justify-between text-sm text-neutral-400">
            <a asp-controller="Account" asp-action="ForgotPassword" class="hover:text-brand">Quên mật khẩu?</a>
            <a asp-controller="Account" asp-action="Register" class="hover:text-brand">Tạo tài khoản mới</a>
        </div>
    </form>

    <div class="mt-6 text-xs text-neutral-500 bg-neutral-900 border border-neutral-800 rounded-xl p-4">
        <p class="font-semibold text-neutral-300 mb-1">Tài khoản demo (dữ liệu mẫu):</p>
        <p>Admin: admin@djstore.com / admin123</p>
        <p>Nhân viên: staff@djstore.com / staff123</p>
        <p>Khách hàng: customer@djstore.com / customer123</p>
    </div>
</div>
