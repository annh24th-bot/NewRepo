@{
    ViewData["Title"] = "Quên mật khẩu";
    bool sent = ViewBag.Sent ?? false;
}
<div class="max-w-md mx-auto px-4 py-16">
    <h1 class="text-2xl font-black mb-6 text-center">Quên mật khẩu</h1>

    @if (sent)
    {
        <div class="bg-green-900/40 border border-green-700 text-green-300 text-sm rounded-lg px-4 py-3 mb-4">
            Nếu email tồn tại trong hệ thống, hướng dẫn đặt lại mật khẩu đã được gửi đến hộp thư của bạn.
        </div>
    }

    <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="space-y-4 bg-neutral-900 border border-neutral-800 rounded-xl p-6">
        <div>
            <label class="block text-sm text-neutral-400 mb-1">Email đăng ký</label>
            <input type="email" name="email" required class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-2" />
        </div>
        <button type="submit" class="w-full bg-brand hover:bg-brand-dark text-white font-bold py-3 rounded-full">Gửi yêu cầu</button>
        <div class="text-sm text-neutral-400 text-center">
            <a asp-controller="Account" asp-action="Login" class="text-brand hover:underline">Quay lại đăng nhập</a>
        </div>
    </form>
</div>
