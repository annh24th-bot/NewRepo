@{
    ViewData["Title"] = "Giới thiệu";
}
<div class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-black mb-6">Về <span class="text-brand">DJ Store</span></h1>
    <p class="text-neutral-400 leading-relaxed mb-4">
        DJ Store là hệ thống cửa hàng thiết bị DJ, phần mềm bản quyền và gói nhạc chuyên nghiệp,
        phục vụ cộng đồng DJ Việt Nam từ nghiệp dư đến chuyên nghiệp. Chúng tôi cung cấp các sản phẩm
        chính hãng từ Pioneer DJ, Denon DJ, Native Instruments cùng dịch vụ bản quyền Rekordbox, Serato, FL Studio.
    </p>
    <p class="text-neutral-400 leading-relaxed">
        Đội ngũ tư vấn giàu kinh nghiệm luôn sẵn sàng hỗ trợ bạn lựa chọn thiết bị phù hợp với ngân sách
        và phong cách trình diễn của riêng bạn.
    </p>
</div>
